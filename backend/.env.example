# Database
DATABASE_URL=sqlite:///./data/chat.db

# JWT Settings (obrigatórios)
SECRET_KEY=your-secret-key-here-change-in-production

# Google Gemini API (obrigatório)
GOOGLE_API_KEY=your-google-api-key-here

QTD_TOKENS_DEFAULT=insert-default-token-quantity-here

# AWS S3 Configuration (obrigatório)
AWS_ACCESS_KEY_ID=your-aws-access-key-id-here
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key-here
AWS_REGION=us-east-1
S3_BUCKET_NAME=rag-chatbot-bucket

# Upload Settings
MAX_PDF_SIZE_MB=50
PROFILE_PICTURE_MAX_SIZE_MB=5

# RAG Settings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
DEFAULT_K_CHUNKS=10

# Opcional - apenas se quiser sobrescrever os padrões:
# ACCESS_TOKEN_EXPIRE_MINUTES=10080  # Padrão: 10080 (7 dias)
# ALGORITHM=HS256                     # Padrão: HS256
# MAX_UPLOAD_SIZE_MB=100             # Padrão: 100MB (FastAPI)
